[TEMPLATE]

# ── FREE API KEYS ─────────────────────────────
# Groq (free tier): LLM + Whisper STT — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
# Optional model overrides
LLM_MODEL=openai/gpt-oss-120b
STT_MODEL=whisper-large-v3

# ── TELEPHONY (required for real phone calls) ──
# Twilio (RECOMMENDED — free trial number + credit): https://www.twilio.com/try-twilio
# Console shows Account SID + Auth Token; claim a trial number under
# Phone Numbers > Manage > Buy a number (free on trial).
# NOTE: trial accounts can only call numbers you verify by SMS OTP in the console.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567
# Country code assumed when someone types a bare 10-digit number ("98765 43210").
# Change it to your own country; anyone dialling abroad types "+<cc><number>" directly.
DEFAULT_COUNTRY_CODE=91

# Vonage (optional fallback — needs a $10 top-up before you can buy a number,
# and Vonage voice authenticates with JWT so it also needs an application
# plus its private key, not just the API key/secret)
VONAGE_API_KEY=your_vonage_api_key
VONAGE_API_SECRET=your_vonage_api_secret_key
VONAGE_PHONE_NUMBER=+1234567890
VONAGE_APPLICATION_ID=your_vonage_application_uuid
VONAGE_PRIVATE_KEY_PATH=./private.key

# ── NO KEY NEEDED ─────────────────────────────
# Text-to-speech uses Microsoft Edge TTS (edge-tts) — completely free.
# Twilio is called over plain HTTPS, so there is no twilio package to install.

# ── APP CONFIG ────────────────────────────────
# The public base URL the phone provider calls back on. For real phone calls
# this MUST be a public tunnel (ngrok / loca.lt), not localhost — the provider
# cannot reach your machine otherwise and every call will fail to connect.
# `python backend/start_tunnel.py` starts one and prints the URL; paste it here.
# Leave it as localhost for console-only use.
PUBLIC_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./business_voice_agents.db
LOG_LEVEL=INFO

# ── SECURITY ──────────────────────────────────
# Signs auth tokens. Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
# Leaving this blank falls back to a public default that anyone can forge — do not.
SECRET_KEY=
